<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>My Personal Page</title>

  <style>
    /* 1. CSS VARIABLES */
    :root {
      --primary: #0f766e;
      --accent: #14b8a6;
      --bg: #f0fdfa;
      --card-bg: white;
      --text: #1e293b;
      --nav-bg: #1e293b;
      --radius: 12px;
      --space: 20px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: Arial, sans-serif;
    }


    /* 2. FIXED NAVIGATION BAR */
    .navbar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 60px;

      background: var(--nav-bg);

      display: flex;
      align-items: center;
      justify-content: space-between;

      padding: 0 30px;
      z-index: 1000;
    }

    .logo {
      color: white;
      font-size: 20px;
      font-weight: bold;
    }

    .nav-links {
      display: flex;
      gap: 20px;
    }

    .nav-links a {
      color: white;
      text-decoration: none;
    }

    .nav-links a:hover {
      color: var(--accent);
    }


    /* 3. HERO SECTION + FADE-IN ANIMATION */
    .hero {
      min-height: 500px;

      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;

      text-align: center;
      padding: 100px 20px 40px;

      animation: fadeIn 1.5s ease;
    }

    .hero h1 {
      color: var(--primary);
      font-size: 48px;
      margin-bottom: 10px;
    }

    .hero p {
      font-size: 20px;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }


    /* 5. STICKY SECTION HEADING */
    .section-heading {
      position: sticky;
      top: 60px;

      background: var(--bg);
      padding: 15px 20px;

      border-bottom: 2px solid var(--primary);

      z-index: 10;
    }


    /* 4. RESPONSIVE GRID */
    .skills-section {
      padding: 20px 30px 100px;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space);
    }

    .card {
      position: relative;

      background: var(--card-bg);
      border: 2px solid var(--primary);
      border-radius: var(--radius);

      padding: 30px;

      transition: transform 0.3s ease,
                  box-shadow 0.3s ease;
    }

    /* Emoji icon */
    .card::before {
      content: "⭐";

      display: block;
      font-size: 30px;
      margin-bottom: 10px;
    }

    .card:hover {
      transform: translateY(-8px);
      box-shadow: 0 12px 25px rgba(20, 184, 166, 0.3);
    }

    .card h3 {
      color: var(--primary);
    }


    /* 3 COLUMNS ON DESKTOP */
    @media (min-width: 640px) {
      .grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }


    /* DARK MODE */
    @media (prefers-color-scheme: dark) {
      :root {
        --primary: #2dd4bf;
        --accent: #5eead4;
        --bg: #0f172a;
        --card-bg: #1e293b;
        --text: #f1f5f9;
        --nav-bg: #020617;
      }
    }
  </style>
</head>

<body>

  <!-- FIXED NAVIGATION -->
  <nav class="navbar">
    <div class="logo">Chingun</div>

    <div class="nav-links">
      <a href="#home">Home</a>
      <a href="#skills">Skills</a>
    </div>
  </nav>


  <!-- HERO SECTION -->
  <section class="hero" id="home">
    <h1>Hi, I'm Chingun</h1>

    <p>
      I'm a Computer Science student who enjoys technology,
      creativity, and learning new things.
    </p>
  </section>


  <!-- STICKY HEADING -->
  <h2 class="section-heading" id="skills">
    My Skills
  </h2>


  <!-- SKILLS GRID -->
  <section class="skills-section">

    <div class="grid">

      <div class="card">
        <h3>💻 Programming</h3>
        <p>
          I enjoy learning programming and building
          useful applications.
        </p>
      </div>

      <div class="card">
        <h3>🎬 Video Editing</h3>
        <p>
          I can edit videos and create interesting
          visual content.
        </p>
      </div>

      <div class="card">
        <h3>🍳 Cooking</h3>
        <p>
          I enjoy cooking and trying different
          recipes.
        </p>
      </div>

      <div class="card">
        <h3>📚 Reading</h3>
        <p>
          Reading helps me learn new ideas and
          improve my knowledge.
        </p>
      </div>

      <div class="card">
        <h3>🌎 Languages</h3>
        <p>
          I enjoy learning new languages and
          communicating with different people.
        </p>
      </div>

      <div class="card">
        <h3>⚽ Football</h3>
        <p>
          Football is one of my favorite activities
          and interests.
        </p>
      </div>

    </div>

  </section>

</body>
</html>
