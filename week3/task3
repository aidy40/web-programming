<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">

<style>
  .spinner {
    width: 50px;
    height: 50px;
    background: transparent;
    border: 4px solid #99f6e4;
    border-top: 4px solid #0f766e;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }
  }
</style>

</head>

<body>

  <div class="spinner"></div>

</body>
</html>
