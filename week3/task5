<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">

<style>
  body {
    margin: 0;
    font-family: Arial, sans-serif;
  }

  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 60px;
    background: #1e293b;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 30px;
    box-sizing: border-box;
  }

  .logo {
    color: white;
    font-size: 20px;
    font-weight: bold;
  }

  .links {
    display: flex;
    gap: 25px;
  }

  .links a {
    color: white;
    text-decoration: none;
  }

  .links a:hover {
    color: teal;
  }

  .content {
    padding: 100px 30px;
    height: 1500px;
  }
</style>

</head>

<body>

  <nav class="navbar">
    <div class="logo">MyWebsite</div>

    <div class="links">
      <a href="#">Home</a>
      <a href="#">About</a>
      <a href="#">Services</a>
      <a href="#">Contact</a>
    </div>
  </nav>

  <main class="content">
    <h1>Welcome to My Website</h1>
    <p>Scroll down to see the navigation bar stay at the top.</p>
  </main>

</body>
</html>
