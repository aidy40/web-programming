<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">

<style>
  .card {
    width: 280px;
    height: 180px;
    background: white;
    border: 2px solid #008b8b;
    border-radius: 12px;
    position: relative;
    margin: 40px;
  }

  .badge {
    position: absolute;
    top: -10px;
    right: 14px;
    background: #006666;
    color: white;
    font-size: 12px;
    font-weight: bold;
    padding: 5px 14px;
    border-radius: 20px;
  }
</style>

</head>

<body>

  <div class="card">
    <span class="badge">SALE</span>
    <p style="padding:16px;color:#006666;font-weight:bold">
      Special offer available!
    </p>
  </div>

</body>
</html>
